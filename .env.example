# Copy to .env and fill in. Never commit the real .env.

PORT=3000

# Local PostgreSQL (used when DATABASE_URL is not set)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=mybookshelf
DB_PASSWORD=
DB_PORT=5432

# Hosted database (Neon). Leave unset locally so dev never touches production data.
# DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

JWT_SECRET=

GOOGLE_BOOKS_API_KEY=

# ---- Book cover uploads (Vercel Blob, public store) ----
# Vercel > Storage > your Blob store > .env.local tab. Vercel adds it to the deployed site automatically.
BLOB_READ_WRITE_TOKEN=

# ---- Password reset emails ----
# Public URL of the site, used in the emailed link. On Vercel this falls back to
# the production domain automatically; locally it falls back to http://localhost:PORT.
# APP_URL=https://your-app.vercel.app

# SMTP settings. Example for Gmail (needs 2-Step Verification + an App Password):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=you@gmail.com  SMTP_PASS=<16-char app password>
# Without these, reset links are printed in the server console (local development only).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MyBookShelf <you@gmail.com>"
